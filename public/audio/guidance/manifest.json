      "transcriptSha256": "339569fd08af0693b4e1d2ec1690b5ac62125c46781a32109ea3527dff4ff1bc",
      "audioSha256": "7b475508c6f1fbbb6d46f6cde4dcd9d22119d28d8a2949f1b2c2d4519a4b726f",
      "bytes": 27001,
      "durationSeconds": 3.289252,
      "rms": 0.09785322934344738
    },
    {
      "id": "toan-hoc-am-thanh-22",
      "file": "toan-hoc-am-thanh-22.v1.mp3",
      "transcript": "Dãy nhịp ba, sáu, mười hai. Nếu mỗi lần gấp đôi, số tiếp là gì?",
      "transcriptSha256": "8ecb8e29e42bff253cfa170aa67f9cab7f6fbc0acafe0de67cca5c41b37161a0",
      "audioSha256": "dfc78aea9e6d92593e3afe9720bd84958d5f4e9fa5d9ee64996e66e09fd40068",
      "bytes": 51243,
      "durationSeconds": 6.309615,
      "rms": 0.09707905747696557
    },
    {
      "id": "toan-hoc-am-thanh-23",
      "file": "toan-hoc-am-thanh-23.v1.mp3",
      "transcript": "Ba mươi tiếng chuông chia thành năm nhóm đều nhau. Mỗi nhóm mấy tiếng?",
      "transcriptSha256": "45e11dcf7ee62efdee6c3ed3c0ccab878b933c69cb189bbfad461f85bc9f4ab4",
      "audioSha256": "a778be2f64583cfd863045e7fdc969e06ff3d01e9a0875050c76303f6868d8c1",
      "bytes": 40585,
      "durationSeconds": 4.974422,
      "rms": 0.09865163983067035
    },
    {
      "id": "toan-hoc-am-thanh-24",
      "file": "toan-hoc-am-thanh-24.v1.mp3",
      "transcript": "Có năm nhóm bốn tiếng gõ, thêm ba tiếng cuối. Tổng bao nhiêu?",
      "transcriptSha256": "9e976c13eb5341d2446357aab274556f87c5655ccf3f3c0757fd192ef89c8f5a",
      "audioSha256": "15d51580e6d470d42cfbc9c65abaa13617dfdef294c99727b8ab724835b66129",
      "bytes": 39958,
      "durationSeconds": 4.889887,
      "rms": 0.09766008908360707
    },
    {
      "id": "phieu-luu-giai-do-1",
      "file": "phieu-luu-giai-do-1.v1.mp3",
      "transcript": "Cổng Rừng Ngân Nga khép kín. Biển ghi: chọn tiếng chào thân thiện để mở cổng.",
      "transcriptSha256": "ee2a664fb5219df651323040fc85690825b044c383eec64e685825efb8239f0a",
      "audioSha256": "a06eb3b41dda5910c4ccc0d68a43b03097954a0acbd044d08aa4550e4450fdbd",
      "bytes": 47272,
      "durationSeconds": 5.80907,
      "rms": 0.1008125379501875
    },
    {
      "id": "phieu-luu-giai-do-2",
      "file": "phieu-luu-giai-do-2.v1.mp3",
      "transcript": "Bạn Sóc nhờ tìm con vật kêu meo meo ở ngã rẽ. Em gọi ai?",
      "transcriptSha256": "153e2daeb869ea7b7950f1a5a60571cc7689fcec36576a82e7086c82d2d6f3c4",
      "audioSha256": "aec71ba3f45a436d932102cee3e494fdf30c4fabb82e057d4566a99331401051",
      "bytes": 39958,
      "durationSeconds": 4.893152,
      "rms": 0.09137918155752994
    },
    {
      "id": "phieu-luu-giai-do-3",
      "file": "phieu-luu-giai-do-3.v1.mp3",
      "transcript": "Cầu có hai tấm ván, Sóc mang thêm một tấm. Có tất cả mấy tấm?",
      "transcriptSha256": "8a95a0a9c1a445876a2e1d9ff4e375aaa99be453e7a64f6183d78fc59c0bec78",
      "audioSha256": "3d3ceedcb9e1d86615c42f42c02deb10d966c646cb227abb48768d792ef948ab",
      "bytes": 43719,
      "durationSeconds": 5.367891,
      "rms": 0.0970687633736011
    },
    {
      "id": "phieu-luu-giai-do-4",
      "file": "phieu-luu-giai-do-4.v1.mp3",
      "transcript": "Ở bờ suối, tiếng gì gợi ý có dòng nước?",
      "transcriptSha256": "4c6b8d7a7ed9a5327b6238228dfc3f4b6fe86b25f6721a1feacdb5a6ea042a8d",
      "audioSha256": "0f604b38361e94ffea8fe3ae47f1ec5ee6fdc7fe8a0ccba13571478880c1a50c",
      "bytes": 28255,
      "durationSeconds": 3.424762,
      "rms": 0.10145949594668927
    },
    {
      "id": "phieu-luu-giai-do-5",
      "file": "phieu-luu-giai-do-5.v1.mp3",
      "transcript": "Đường đi chia hai. Bản đồ ghi: đến cây có lá xanh. Em chọn đâu?",
      "transcriptSha256": "6f38588edb2353c7f93dd74a78806af74b6cd014a7dace922bb7aabd959c16c5",
      "audioSha256": "c3fbffd5d0c6241ed7930b2a57f7b98524f50063f9b124148501c81a36cba538",
      "bytes": 47063,
      "durationSeconds": 5.783855,
      "rms": 0.09664173914700787
    },
    {
      "id": "phieu-luu-giai-do-6",
      "file": "phieu-luu-giai-do-6.v1.mp3",
      "transcript": "Hộp nhạc cần nốt tiếp theo: Đô, Mi, Đô, Mi… Em chọn nốt nào?",
      "transcriptSha256": "674e6eeded8e902f4551af359e845afa03a810f49e19d9012e6520a84bf6c2be",
      "audioSha256": "8cb9792af2c4372f091fc106657f8a4531bfa63cd5babdec008fbde6d28b0b9a",
      "bytes": 50616,
      "durationSeconds": 6.239592,
      "rms": 0.09939097412732972
    },
    {
      "id": "phieu-luu-giai-do-7",
      "file": "phieu-luu-giai-do-7.v1.mp3",
      "transcript": "Trời bắt đầu mưa. Em chọn gì để giữ bản đồ khô?",
      "transcriptSha256": "08ae628af92fe3e1e34152b2c65c5ade8a910c47e90c440b954646f1b84d5e6b",
      "audioSha256": "ece7df5c93ff466c828858690a2f6cef3904e269c807502074b3ee2abcbab380",
      "bytes": 33688,
      "durationSeconds": 4.106485,
      "rms": 0.10304835528945704
    },
    {
      "id": "phieu-luu-giai-do-8",
      "file": "phieu-luu-giai-do-8.v1.mp3",
      "transcript": "Sóc giúp em mang bản đồ suốt chuyến đi. Em nói gì?",
      "transcriptSha256": "0d202a09cc258947c06c5345010afc9ce00803c656563526b988f632bf016c8e",
      "audioSha256": "5f154a6e708d09f12fbbe46473abd211661ef0991bd05a9e98b628746b2f71f3",
      "bytes": 34106,
      "durationSeconds": 4.170159,
      "rms": 0.09764352710452215
    },
    {
      "id": "phieu-luu-giai-do-9",
      "file": "phieu-luu-giai-do-9.v1.mp3",
      "transcript": "Đảo Chuông bị mất giai điệu. Thuyền cần mật mã: ba cộng bốn.",
      "transcriptSha256": "1e29af8ba51ce10b54954c286bfe13cc2af0c07952a52a379ee75540170a1deb",
      "audioSha256": "d8d131a07011cd4d36cba92c3f0bb99e4204e307789ec674a8cc8e5f4587887e",
      "bytes": 38286,
      "durationSeconds": 4.680952,
      "rms": 0.09954278385161007
    },
    {
      "id": "phieu-luu-giai-do-10",
      "file": "phieu-luu-giai-do-10.v1.mp3",
      "transcript": "Bến có tiếng chuông cao và trống trầm. Biển chỉ đường ghi: theo tiếng trầm.",
      "transcriptSha256": "56cb3aa839aed489a4b32c1d84b84a21817792a7eddda9e556da8136039d53bc",
      "audioSha256": "391c2fdbe8f97657b6e3467ab2ee76b35d88c2d2ef5cf13c03642bc2f4a7c25d",
      "bytes": 46227,
      "durationSeconds": 5.671746,
      "rms": 0.09803116758016724
    },
    {
      "id": "phieu-luu-giai-do-11",
      "file": "phieu-luu-giai-do-11.v1.mp3",
      "transcript": "Trong hang, một tiếng gọi vang lại. Hiện tượng đó là gì?",
      "transcriptSha256": "c0541758a0a4168dc88eb4559bbd96f04c252a8f374cbd323a2d02e8a0d3f9af",
      "audioSha256": "bfbdb27b7dcebb40633d3d8534885bbc9a162902e1416f2dd93f09dfce3c7de1",
      "bytes": 36405,
      "durationSeconds": 4.443175,
      "rms": 0.0992197035858754
    },
    {
      "id": "phieu-luu-giai-do-12",
      "file": "phieu-luu-giai-do-12.v1.mp3",
      "transcript": "Cửa hang có mẫu ngắn, ngắn, dài, ngắn, ngắn… Nhịp tiếp theo là gì?",
      "transcriptSha256": "e23e8c4c155e8d7db24a70b216eab9e9f03693f1bd5397f76497a65c86ccb6a7",
      "audioSha256": "1537fb11e987bff357ab2fbb7c92da1196564b6be6dc6aadb2e3cc610a5336af",
      "bytes": 50407,
      "durationSeconds": 6.213424,
      "rms": 0.09660453591845322
    },
    {
      "id": "phieu-luu-giai-do-13",
      "file": "phieu-luu-giai-do-13.v1.mp3",
      "transcript": "Vườn có mười chiếc chuông, hai chiếc hỏng. Còn mấy chiếc dùng được?",
      "transcriptSha256": "8a1962b8b554bb52d64eb08fcf272045ac46c3c17af457e34f48dfe249a4d888",
      "audioSha256": "78e1f370aa2730212bed3c1afc456f875e2b8b64d343d6b3ea55b6cd6967644e",
      "bytes": 39122,
      "durationSeconds": 4.787256,
      "rms": 0.10114237266726431
    },
    {
      "id": "phieu-luu-giai-do-14",
      "file": "phieu-luu-giai-do-14.v1.mp3",
      "transcript": "Cây cầu phát tiếng cọt kẹt và có ván gãy. Em nên làm gì?",
      "transcriptSha256": "28e86300ef83117f6bbc62b16e90cadf75ff021aefe437ff92803d6bf13ba1d6",
      "audioSha256": "6a8734a11c4d39f105ea09be30b4602d3602c4be43ea601feba30b2f4906f81e",
