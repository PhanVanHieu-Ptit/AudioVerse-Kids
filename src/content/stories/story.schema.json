{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:audioverse:story:v1",
  "title": "AudioVerse Kids Story v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "language",
    "level",
    "title",
    "introduction",
    "themes",
    "characters",
    "entrySceneId",
    "scenes",
    "positiveMessage",
    "transcript",
    "accessibilityNotes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 100
    },
    "language": {
      "const": "vi"
    },
    "level": {
      "type": "integer",
      "enum": [1, 2, 3]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000,
      "pattern": "\\S"
    },
    "introduction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000,
      "pattern": "\\S"
    },
    "themes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "enum": [
          "friendship",
          "nature",
          "animals",
          "exploration",
          "science",
          "life-skills",
          "imagination"
        ]
      },
      "uniqueItems": true
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000,
            "pattern": "\\S"
          }
        }
      }
    },
    "entrySceneId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 100
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "segments",
          "soundEffects",
          "interaction",
          "questions",
          "ending"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000,
            "pattern": "\\S"
          },
          "segments": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "speakerId", "text"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                  "maxLength": 100
                },
                "speakerId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                  "maxLength": 100
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000,
                  "pattern": "\\S"
                }
              }
            }
          },
          "soundEffects": {
            "type": "array",
            "minItems": 0,
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "description",
                "anchorSegmentId",
                "placement",
                "productionNotes"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                  "maxLength": 100
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000,
                  "pattern": "\\S"
                },
                "anchorSegmentId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                  "maxLength": 100
                },
                "placement": {
                  "enum": ["before", "after"]
                },
                "productionNotes": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000,
                  "pattern": "\\S"
                }
              }
            }
          },
          "interaction": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["prompt", "choices"],
                "properties": {
                  "prompt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 12000,
                    "pattern": "\\S"
                  },
                  "choices": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 4,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["id", "label", "nextSceneId"],
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                          "maxLength": 100
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 12000,
                          "pattern": "\\S"
                        },
                        "nextSceneId": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                          "maxLength": 100
                        }
                      }
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "questions": {
            "type": "array",
            "minItems": 0,
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "prompt", "options", "suggestedOptionId"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                  "maxLength": 100
                },
                "prompt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000,
                  "pattern": "\\S"
                },
                "options": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 4,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "label", "feedback"],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                        "maxLength": 100
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 12000,
                        "pattern": "\\S"
                      },
                      "feedback": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 12000,
                        "pattern": "\\S"
                      }
                    }
                  }
                },
                "suggestedOptionId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                      "maxLength": 100
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "ending": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "title", "message"],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                    "maxLength": 100
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 12000,
                    "pattern": "\\S"
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 12000,
                    "pattern": "\\S"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "oneOf": [
          {
            "properties": {
              "interaction": {
                "type": "object"
              },
              "ending": {
                "type": "null"
              }
            }
          },
          {
            "properties": {
              "interaction": {
                "type": "null"
              },
              "ending": {
                "type": "object"
              }
            }
          }
        ]
      }
    },
    "positiveMessage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000,
      "pattern": "\\S"
    },
    "transcript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "file"],
      "properties": {
        "format": {
          "const": "text/markdown"
        },
        "file": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.md$"
        }
      }
    },
    "accessibilityNotes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000,
        "pattern": "\\S"
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "title",
        "attribution",
        "referenceUrl",
        "rightsNote",
        "rightsReferences",
        "reviewedOn",
        "adaptationNotes"
      ],
      "properties": {
        "kind": {
          "enum": ["folk-tale", "public-domain-source"]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000,
          "pattern": "\\S"
        },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000,
          "pattern": "\\S"
        },
        "referenceUrl": {
          "type": "string",
          "pattern": "^https://[^\\s]+$",
          "maxLength": 2048
        },
        "rightsNote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000,
          "pattern": "\\S"
        },
        "rightsReferences": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "pattern": "^https://[^\\s]+$",
            "maxLength": 2048
          }
        },
        "reviewedOn": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
        },
        "adaptationNotes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000,
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
