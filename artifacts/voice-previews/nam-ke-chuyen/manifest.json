          "cueId": "rua-va-tho.scene.cuoc-hen.title",
          "speaker": "Người kể",
          "text": "Cuộc đua đã thống nhất",
          "voice": "Thanh Bình",
          "tempo": 1,
          "pauseMs": 800,
          "startSeconds": 0.0,
          "durationSeconds": 0.9538541666666667,
          "cacheSha256": "d9c4f820a3d537f9e7dc2e7b73b23c725f0912dbcae4c6cb28e10ee7f0dfcd75"
        },
        {
          "cueId": "rua-va-tho.scene.cuoc-hen.segment.line-1",
          "speaker": "Người kể",
          "text": "Trong khu rừng tưởng tượng, Thỏ trêu rằng Rùa đi chậm. Rùa đáp: “Tớ muốn thử một cuộc đua với cậu.” Hai bạn cùng đồng ý, không ai bị ép tham gia.",
          "voice": "Thanh Bình",
          "tempo": 1,
          "pauseMs": 500,
          "startSeconds": 1.7538541666666667,
          "durationSeconds": 7.277104166666667,
          "cacheSha256": "1485a78de7b814e6f76a7649fb0be30690ef4a0a099b6f8185fb227e205432af"
        },
        {
          "cueId": "rua-va-tho.scene.cuoc-hen.segment.line-2",
          "speaker": "Người kể",
          "text": "Sẻ đọc rõ đường đua và điểm kết thúc cho mọi người. Khi cuộc đua bắt đầu, Thỏ chạy một đoạn xa rồi nghĩ Rùa còn lâu mới tới. Thỏ nằm nghỉ dưới gốc cây và ngủ quên.",
          "voice": "Thanh Bình",
          "tempo": 1,
          "pauseMs": 500,
          "startSeconds": 9.530958333333333,
          "durationSeconds": 8.634791666666667,
          "cacheSha256": "08be7cf8ef333a179f1b96fb2e244f3aa97c9963e72769cd2de146b7db1f00e1"
        },
        {
          "cueId": "rua-va-tho.scene.cuoc-hen.segment.line-3",
          "speaker": "Người kể",
          "text": "Rùa tiếp tục theo nhịp của mình. Khi Sẻ nói Thỏ đang ngủ, Rùa không dừng để trêu lại. Rùa tới đích trước. Thỏ thức dậy, chạy đến nơi thì nghe Sẻ thông báo kết quả.",
          "voice": "Thanh Bình",
          "tempo": 1,
          "pauseMs": 500,
          "startSeconds": 18.66575,
          "durationSeconds": 8.792604166666667,
          "cacheSha256": "70b2e1cf6874f9f9334fc1da6c4330be341e40593c02e2b3842aaad623fa3475"
        },
        {
          "cueId": "rua-va-tho.scene.xin-loi.title",
          "speaker": "Người kể",
          "text": "Một lời sau cuộc đua",
          "voice": "Thanh Bình",
          "tempo": 1,
          "pauseMs": 800,
          "startSeconds": 27.958354166666666,
          "durationSeconds": 1.1932083333333334,
          "cacheSha256": "545cb702f331d6b59b03f43b0863fddd9b7410b4a9a4a3978bced5d4ae03bf90"
        },
        {
          "cueId": "rua-va-tho.scene.xin-loi.segment.line-1",
          "speaker": "Thỏ",
          "text": "Thỏ nói: Tớ xin lỗi vì đã trêu cậu. Tớ cũng chủ quan trong cuộc đua này.",
          "voice": "Xuân Vĩnh",
          "tempo": 1,
          "pauseMs": 400,
          "startSeconds": 29.9515625,
          "durationSeconds": 4.1568958333333335,
          "cacheSha256": "e1042c47327a7a03796078e848917940beb73c5504863a1a4aeb6a05921ee48a"
        },
        {
          "cueId": "rua-va-tho.scene.xin-loi.segment.line-2",
          "speaker": "Rùa",
          "text": "Rùa nói: Cảm ơn cậu đã nói vậy. Tớ muốn được chơi mà không bị chê về cách đi của mình.",
          "voice": "Thanh Bình",
          "tempo": 0.98,
          "pauseMs": 550,
          "startSeconds": 34.50845833333333,
          "durationSeconds": 4.966666666666667,
          "cacheSha256": "319373df1145f9e2d3351bce5da4599dc9009d39cb9e0f3a66a020b9d0e655e0"
        },
        {
          "cueId": "rua-va-tho.scene.xin-loi.segment.line-3",
          "speaker": "Người kể",
          "text": "Thỏ lắng nghe đến hết câu. Bạn không xin đua lại ngay để cố xóa kết quả vừa rồi.",
          "voice": "Thanh Bình",
          "tempo": 1,
          "pauseMs": 500,
          "startSeconds": 40.025125,
          "durationSeconds": 4.0739375,
          "cacheSha256": "c08aee43f7bbb4fb11e3035ef90080fc335094090465a81b47c128e4d8e74b16"
        }
      ]
