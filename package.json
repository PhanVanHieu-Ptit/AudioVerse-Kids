{
  "name": "audioverse-kids",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite --mode development",
    "build": "npm run typecheck && vite build --mode production",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "voice:generate": "node --experimental-strip-types scripts/generate-voice-guidance.mjs",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:audio": "playwright test --config playwright.audio.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run content:validate && npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run test:e2e && npm run test:e2e:audio",
    "content:build": "node --experimental-strip-types scripts/story-content.ts --write",
    "content:validate": "node --experimental-strip-types scripts/story-content.ts --check",
    "stories:audio:generate": "node --experimental-strip-types scripts/generate-story-audio.ts",
    "stories:voice:preview": "node --experimental-strip-types scripts/local-tts/preview-plan.ts && .cache/local-tts/venv/bin/python scripts/local-tts/render-preview.py",
    "stories:voice:check": "node --experimental-strip-types scripts/local-tts/check-preview.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "idb": "^8.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "zustand": "^5.0.8"
  },
  "overrides": {
    "workbox-build": {
      "glob": "^14.0.2"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.4",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.2",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "4.1.12"
  }
}
